---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.tsx';
---

<Layout
  title="Transmit Message // Routing Endpoint | Kunal Jangid"
  description="Contact Kunal Jangid, Software Engineer based in Gurugram, IN. Transmit secure messages directly to his routing endpoints."
>
  <div class="max-w-2xl mx-auto px-4 py-8 relative z-10 font-mono text-xs">
    <!-- Back Navigation -->
    <div class="mb-8">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest border border-brand-border/30 px-4 py-2 rounded hover:bg-brand-text hover:text-brand-bg transition-all duration-300"
      >
        ← Return to Operations Dashboard
      </a>
    </div>

    <!-- Form Container -->
    <div class="w-full">
      <ContactForm client:load alwaysOpen={true} />
    </div>
  </div>
</Layout>
