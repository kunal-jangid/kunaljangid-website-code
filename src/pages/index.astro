---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import titleSelfie from '../assets/title-selfie.png';
import Layout from '../layouts/Layout.astro';
import BentoItem from '../components/BentoItem.astro';
import ProjectCard from '../components/ProjectCard.tsx';
import SpotifyStatus from '../components/SpotifyStatus.tsx';
import GadgetsCard from '../components/GadgetsCard.tsx';
import FramesCard from '../components/FramesCard.tsx';
import TerminalCLI from '../components/TerminalCLI.tsx';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

// Fetch Spotify telemetry server-side to bypass browser CORS on localhost
let initialSpotifyData = null;
try {
  const res = await fetch('https://spotify-telemetry.kunaljangid2k3.workers.dev');
  if (res.ok) {
    initialSpotifyData = await res.json();
  }
} catch (e) {
  console.warn("Failed to fetch server-side Spotify data:", e);
}
---

<Layout
  title="Kunal Jangid | Systems Software Engineer"
  description="Kunal Jangid - Software Engineer based in Gurugram, IN. Designing robust financial software architectures and high-density terminal consoles."
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 xl:gap-10 w-full auto-rows-min font-mono text-xs">
    
    <!-- COLUMN 1: SYSTEM CONTROLLER (LEFT - 4/12 SPAN) -->
    <div class="col-span-1 lg:col-span-4 flex flex-col gap-6">
      <!-- SYSTEM CREDENTIALS LOG -->
      <div class="flex flex-col gap-2">
        <h2 class="text-xs uppercase tracking-widest text-brand-accent font-bold px-1">// SEC_SYS_LOG // ABOUT_ME</h2>
        <BentoItem span={1} row={1} class="!p-5 flex flex-col gap-4 border border-brand-border/20">
          <div class="text-xs leading-relaxed space-y-3 font-sans text-brand-text/80 select-text">
            <p>
              I architect high-throughput financial platforms and untangle multi-generational legacy architectures. Currently serving as an <span class="text-brand-accent font-semibold">Associate Software Engineer at OSTTRA</span>.
            </p>
            <p>
              Specialized in complex state machines, strict regulatory business logic, and web tooling modernization. 
            </p>
          </div>
        </BentoItem>
      </div>

      <!-- TERMINAL CLI MODULE (Hidden on phone/tablet) -->
      <div class="hidden lg:flex flex-col gap-2">
        <h2 class="text-xs uppercase tracking-widest text-brand-accent font-bold px-1">// SEC_CMD_LINE // ACTIVE_PROMPT</h2>
        <TerminalCLI client:load />
      </div>
    </div>

    <!-- COLUMN 2: QUANT PROJECT LEDGER (CENTER - 5/12 SPAN) -->
    <div class="col-span-1 lg:col-span-5 flex flex-col gap-4 border-t lg:border-t-0 lg:border-x border-brand-border/20 lg:px-8">
      <div class="flex items-center justify-between border-b border-brand-border/20 pb-2">
        <h2 class="text-xs uppercase tracking-widest text-brand-accent font-bold px-1">// SEC_WORK_LEDGER // PROJECT_NODES</h2>
        <span class="text-[9px] text-brand-text/40 font-mono">NODE_COUNT: {projects.length}</span>
      </div>

      <!-- SINGLE INTEGRATED LEDGER LIST -->
      <div class="flex flex-col w-full">
        {projects.map((project) => (
          <ProjectCard
            client:load
            title={project.data.title}
            subtitle={project.data.subtitle}
            tags={project.data.tags}
            friction={project.data.friction}
            fix={project.data.fix}
            payoff={project.data.payoff}
          />
        ))}
      </div>
    </div>

    <!-- COLUMN 3: TELEMETRY SIGNAL FEED (RIGHT - 3/12 SPAN) -->
    <div class="col-span-1 lg:col-span-3 flex flex-col gap-6">
      <!-- LIVE SPOTIFY FEED -->
      <div class="flex flex-col gap-2">
        <h2 class="text-xs uppercase tracking-widest text-brand-accent font-bold px-1">// SEC_TELEMETRY // LIVE_SIGNAL</h2>
        <BentoItem span={1} row={1} class="!p-5 border border-brand-border/20">
          <SpotifyStatus client:load initialData={initialSpotifyData} />
        </BentoItem>
      </div>

      <!-- AUXILIARY FEED: GADGETS (Hidden on phone/tablet) -->
      <div class="hidden lg:flex flex-col gap-2">
        <h2 class="text-xs uppercase tracking-widest text-brand-accent font-bold px-1">// SEC_AUX_01 // DESK_FEEDS</h2>
        <BentoItem span={1} row={1} class="!p-5 border border-brand-border/20 cursor-pointer">
          <GadgetsCard client:load />
        </BentoItem>
      </div>

      <!-- AUXILIARY FEED: IMAGES (Hidden on phone/tablet) -->
      <div class="hidden lg:flex flex-col gap-2">
        <h2 class="text-xs uppercase tracking-widest text-brand-accent font-bold px-1">// SEC_AUX_02 // ENV_FRAMES</h2>
        <FramesCard client:load />
      </div>

      <!-- Q1 2026 HIGHFLYER BANNER -->
      <div class="flex flex-col gap-2">
        <h2 class="text-xs uppercase tracking-widest text-brand-accent font-bold px-1">// SEC_NOTIFY // ALERTS</h2>
        <BentoItem span={1} row={1} class="!p-5 border border-brand-border/20 border-l-4 border-l-brand-accent">
          <div class="flex items-center gap-2 text-brand-accent font-bold mb-1 font-mono">
            <span>🏆</span>
            <span>Q1_2026 // HIGHFLYER</span>
          </div>
          <p class="text-[10px] leading-relaxed text-brand-text/80 font-sans mt-2">
            Recognized across OSTTRA for outstanding execution speed, technical consistency, and platform delivery. Currently onboarding the 2026 new grad cohort.
          </p>
        </BentoItem>
      </div>
    </div>

  </div>
</Layout>

