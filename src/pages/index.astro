---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import titleSelfie from '../assets/title-selfie.png';
import Layout from '../layouts/Layout.astro';
import BentoItem from '../components/BentoItem.astro';
import ProjectCard from '../components/ProjectCard.tsx';
import SpotifyStatus from '../components/SpotifyStatus.tsx';
import GadgetsCard from '../components/GadgetsCard.tsx';
import FramesCard from '../components/FramesCard.tsx';
import TerminalCLI from '../components/TerminalCLI.tsx';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

// Fetch Spotify telemetry server-side to bypass browser CORS on localhost
let initialSpotifyData = null;
try {
  const res = await fetch('https://spotify-telemetry.kunaljangid2k3.workers.dev');
  if (res.ok) {
    initialSpotifyData = await res.json();
  }
} catch (e) {
  console.warn("Failed to fetch server-side Spotify data:", e);
}
---

<Layout
  title="Kunal Jangid | Systems Software Engineer"
  description="Kunal Jangid - Software Engineer based in Gurugram, IN. Designing robust financial software architectures and high-density terminal consoles."
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 xl:gap-10 w-full auto-rows-min font-mono text-xs">
    
    <!-- COLUMN 1: EDITORIAL BIO & TERMINAL (LEFT - 4/12 SPAN) -->
    <div class="col-span-1 lg:col-span-4 flex flex-col gap-6">
      <!-- EDITORIAL BIO DISPATCH -->
      <div class="flex flex-col gap-2.5">
        <div class="flex items-center justify-between px-1 border-b border-brand-border/60 pb-1.5">
          <h2 class="text-xs uppercase tracking-widest text-brand-accent font-semibold font-mono">01 // ABOUT THE AUTHOR</h2>
          <span class="text-[10px] text-brand-muted font-display italic">Desk Dispatch</span>
        </div>
        <BentoItem span={1} row={1} class="!p-5 flex flex-col gap-4 border border-brand-border bg-brand-surface shadow-none">
          <div class="text-xs leading-relaxed space-y-3 font-sans text-brand-text select-text">
            <p>
              I architect high-throughput financial platforms and untangle multi-generational legacy architectures. Currently serving as an <span class="text-brand-accent font-semibold">Associate Software Engineer at OSTTRA</span>.
            </p>
            <p class="text-brand-muted">
              Specialized in complex state machines, strict regulatory business logic, and modern web tooling architectures.
            </p>
          </div>
          <div class="pt-2 border-t border-brand-border/40 flex items-center justify-between text-[10px] text-brand-muted font-mono">
            <span>LOCATION: GURUGRAM, IN</span>
            <span class="text-brand-accent-sub font-semibold">STATUS: ACTIVE</span>
          </div>
        </BentoItem>
      </div>

      <!-- TERMINAL CLI MODULE (Hidden on phone/tablet) -->
      <div class="hidden lg:flex flex-col gap-2.5">
        <div class="flex items-center justify-between px-1 border-b border-brand-border/60 pb-1.5">
          <h2 class="text-xs uppercase tracking-widest text-brand-accent font-semibold font-mono">02 // CONSOLE PROMPT</h2>
          <span class="text-[10px] text-brand-muted font-mono">press '/' to focus</span>
        </div>
        <TerminalCLI client:load />
      </div>
    </div>

    <!-- COLUMN 2: SELECTED WORKS LEDGER (CENTER - 5/12 SPAN) -->
    <div class="col-span-1 lg:col-span-5 flex flex-col gap-4 border-t lg:border-t-0 lg:border-x border-brand-border/40 lg:px-6">
      <div class="flex items-center justify-between border-b border-brand-border/60 pb-2">
        <div class="flex items-baseline gap-2">
          <h2 class="text-xs uppercase tracking-widest text-brand-accent font-semibold font-mono">03 // SELECTED WORKS</h2>
          <span class="text-sm font-display italic text-brand-text">Index</span>
        </div>
        <span class="text-[10px] text-brand-muted font-mono border border-brand-border px-1.5 py-0.5 rounded bg-brand-surface">ENTRIES: {projects.length}</span>
      </div>

      <!-- SINGLE INTEGRATED LEDGER LIST -->
      <div class="flex flex-col w-full divide-y divide-brand-border/40">
        {projects.map((project, index) => (
          <ProjectCard
            client:load
            index={index + 1}
            title={project.data.title}
            subtitle={project.data.subtitle}
            tags={project.data.tags}
            friction={project.data.friction}
            fix={project.data.fix}
            payoff={project.data.payoff}
          />
        ))}
      </div>
    </div>

    <!-- COLUMN 3: TELEMETRY SIGNAL & AUXILIARY (RIGHT - 3/12 SPAN) -->
    <div class="col-span-1 lg:col-span-3 flex flex-col gap-6">
      <!-- LIVE SPOTIFY FEED -->
      <div class="flex flex-col gap-2.5">
        <div class="flex items-center justify-between px-1 border-b border-brand-border/60 pb-1.5">
          <h2 class="text-xs uppercase tracking-widest text-brand-accent font-semibold font-mono">04 // AUDIO TELEMETRY</h2>
          <span class="text-[10px] text-brand-muted font-display italic">Live Signals</span>
        </div>
        <BentoItem span={1} row={1} class="!p-4 border border-brand-border bg-brand-surface">
          <SpotifyStatus client:load initialData={initialSpotifyData} />
        </BentoItem>
      </div>

      <!-- AUXILIARY FEED: GADGETS (Hidden on phone/tablet) -->
      <div class="hidden lg:flex flex-col gap-2.5">
        <div class="flex items-center justify-between px-1 border-b border-brand-border/60 pb-1.5">
          <h2 class="text-xs uppercase tracking-widest text-brand-accent font-semibold font-mono">05 // DESK & HARDWARE</h2>
          <span class="text-[10px] text-brand-muted font-mono">setup log</span>
        </div>
        <BentoItem span={1} row={1} class="!p-4 border border-brand-border bg-brand-surface cursor-pointer hover:border-brand-accent transition-colors">
          <GadgetsCard client:load />
        </BentoItem>
      </div>

      <!-- AUXILIARY FEED: IMAGES (Hidden on phone/tablet) -->
      <div class="hidden lg:flex flex-col gap-2.5">
        <div class="flex items-center justify-between px-1 border-b border-brand-border/60 pb-1.5">
          <h2 class="text-xs uppercase tracking-widest text-brand-accent font-semibold font-mono">06 // ANALOG FRAMES</h2>
          <span class="text-[10px] text-brand-muted font-display italic">35mm / Digital</span>
        </div>
        <FramesCard client:load />
      </div>

      <!-- Q1 2026 HIGHFLYER BANNER -->
      <div class="flex flex-col gap-2.5">
        <div class="flex items-center justify-between px-1 border-b border-brand-border/60 pb-1.5">
          <h2 class="text-xs uppercase tracking-widest text-brand-accent font-semibold font-mono">07 // RECOGNITION</h2>
          <span class="text-[10px] text-brand-accent font-mono font-bold">★ OSTTRA</span>
        </div>
        <BentoItem span={1} row={1} class="!p-4 border border-brand-border border-l-4 border-l-brand-accent bg-brand-surface">
          <div class="flex items-center gap-2 text-brand-accent font-semibold mb-1 font-mono text-xs">
            <span>🏆</span>
            <span class="tracking-wide">HIGHFLYER AWARD</span>
          </div>
          <p class="text-[11px] leading-relaxed text-brand-muted font-sans mt-2">
            Recognized across OSTTRA for outstanding execution speed, technical consistency, and platform delivery. Currently onboarding the 2026 new grad cohort.
          </p>
        </BentoItem>
      </div>
    </div>

  </div>
</Layout>

