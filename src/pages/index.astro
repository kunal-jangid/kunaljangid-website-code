---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import titleSelfie from '../assets/title-selfie.png';
import Layout from '../layouts/Layout.astro';
import BentoItem from '../components/BentoItem.astro';
import ProjectCard from '../components/ProjectCard.tsx';
import SpotifyStatus from '../components/SpotifyStatus.tsx';
import GadgetsCard from '../components/GadgetsCard.tsx';
import FramesCard from '../components/FramesCard.tsx';
import TerminalCLI from '../components/TerminalCLI.tsx';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

// Fetch Spotify telemetry server-side to bypass browser CORS on localhost
let initialSpotifyData = null;
try {
  const res = await fetch('https://spotify-telemetry.kunaljangid2k3.workers.dev');
  if (res.ok) {
    initialSpotifyData = await res.json();
  }
} catch (e) {
  console.warn("Failed to fetch server-side Spotify data:", e);
}
---

<Layout
  title="Kunal Jangid | Systems Software Engineer"
  description="Kunal Jangid - Software Engineer based in Gurugram, IN. Designing robust financial software architectures and high-density terminal consoles."
>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 xl:gap-12 w-full auto-rows-min font-mono text-xs">
    
    <!-- HEADER HUB BAR (FULL WIDTH) -->
    <header class="col-span-1 lg:col-span-3 border-b border-brand-border/40 pb-6 mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1
          id="theme-toggle"
          class="text-3xl md:text-4xl font-black tracking-tighter cursor-pointer select-none active:scale-[0.99] transition-all duration-200 text-brand-accent hover:opacity-80"
        >
          KUNAL_JANGID // QUANT-HUD
        </h1>
        <p class="text-[10px] opacity-60 uppercase tracking-widest mt-1">
          Systems Operations Dashboard // Gurugram, IN
        </p>
      </div>
      <div class="flex items-center gap-4 text-[10px] text-brand-text/50">
        <span>STATUS: <span class="text-brand-accent animate-pulse font-bold">ONLINE</span></span>
        <span>•</span>
        <span>LATENCY: <span id="system-latency font-mono">12ms</span></span>
        <span>•</span>
        <span>SYS_TIME: <span id="system-clock font-mono">00:00:00</span></span>
      </div>
    </header>

    <!-- COLUMN 1: SYSTEM CONTROLLER (LEFT) -->
    <div class="col-span-1 flex flex-col gap-6">
      <!-- SYSTEM CREDENTIALS LOG -->
      <BentoItem span={1} row={1} class="!p-6 flex flex-col gap-4 border border-brand-border/30">
        <h2 class="text-xs uppercase tracking-widest text-brand-accent font-bold">// SEC_SYS_LOG // ABOUT_ME</h2>
        <div class="text-xs leading-relaxed space-y-3 font-sans text-brand-text/80 select-text">
          <p>
            I architect high-throughput financial platforms and untangle multi-generational legacy architectures. Currently serving as an <span class="text-brand-accent font-semibold">Associate Software Engineer at OSTTRA</span>.
          </p>
          <p>
            Specialized in complex state machines, strict regulatory business logic, and web tooling modernization. 
          </p>
        </div>
      </BentoItem>

      <!-- TERMINAL CLI MODULE -->
      <div class="flex flex-col gap-2">
        <h2 class="text-xs uppercase tracking-widest text-brand-accent font-bold px-1">// SEC_CMD_LINE // ACTIVE_PROMPT</h2>
        <TerminalCLI client:load />
      </div>

      <!-- AVATAR RENDER MODULE -->
      <div class="hidden lg:block overflow-hidden rounded-xl border border-brand-border/20 aspect-square select-none max-w-sm">
        <Image
          src={titleSelfie}
          alt="Kunal Jangid - Systems Engineer"
          format="webp"
          quality={85}
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover filter grayscale contrast-125 dark:grayscale-0 hover:scale-105 transition-all duration-500 ease-out origin-bottom block"
        />
      </div>
    </div>

    <!-- COLUMN 2: QUANT PROJECT LEDGER (CENTER) -->
    <div class="col-span-1 flex flex-col gap-4 border-t lg:border-t-0 lg:border-x border-brand-border/20 lg:px-6 xl:px-8">
      <div class="flex items-center justify-between border-b border-brand-border/20 pb-2">
        <h2 class="text-xs uppercase tracking-widest text-brand-accent font-bold">// SEC_WORK_LEDGER // PROJECT_NODES</h2>
        <span class="text-[9px] text-brand-text/40 font-mono">NODE_COUNT: {projects.length}</span>
      </div>

      <!-- SINGLE INTEGRATED LEDGER LIST -->
      <div class="flex flex-col w-full">
        {projects.map((project) => (
          <ProjectCard
            client:load
            title={project.data.title}
            subtitle={project.data.subtitle}
            tags={project.data.tags}
            friction={project.data.friction}
            fix={project.data.fix}
            payoff={project.data.payoff}
          />
        ))}
      </div>
    </div>

    <!-- COLUMN 3: TELEMETRY SIGNAL FEED (RIGHT) -->
    <div class="col-span-1 flex flex-col gap-6">
      <!-- LIVE SPOTIFY FEED -->
      <div class="flex flex-col gap-2">
        <h2 class="text-xs uppercase tracking-widest text-brand-accent font-bold px-1">// SEC_TELEMETRY // LIVE_SIGNAL</h2>
        <BentoItem span={1} row={1} class="!p-4 border border-brand-border/20">
          <SpotifyStatus client:load initialData={initialSpotifyData} />
        </BentoItem>
      </div>

      <!-- AUXILIARY FEED: GADGETS -->
      <div class="flex flex-col gap-2">
        <h2 class="text-xs uppercase tracking-widest text-brand-accent font-bold px-1">// SEC_AUX_01 // DESK_FEEDS</h2>
        <BentoItem span={1} row={1} class="!p-4 border border-brand-border/20 cursor-pointer">
          <GadgetsCard client:load />
        </BentoItem>
      </div>

      <!-- AUXILIARY FEED: IMAGES -->
      <div class="flex flex-col gap-2">
        <h2 class="text-xs uppercase tracking-widest text-brand-accent font-bold px-1">// SEC_AUX_02 // ENV_FRAMES</h2>
        <BentoItem span={1} row={1} class="!p-4 border border-brand-border/20 cursor-pointer">
          <FramesCard client:load />
        </BentoItem>
      </div>

      <!-- Q1 2026 HIGHFLYER BANNER -->
      <div class="flex flex-col gap-2">
        <h2 class="text-xs uppercase tracking-widest text-brand-accent font-bold px-1">// SEC_NOTIFY // ALERTS</h2>
        <div class="border-l-2 border-brand-accent bg-brand-text/5 p-4 rounded-r-lg font-mono">
          <div class="flex items-center gap-2 text-brand-accent font-bold mb-1">
            <span>🏆</span>
            <span>OSTTRA HIGHFLYER AWARD // Q1_2026</span>
          </div>
          <p class="text-[10px] leading-relaxed text-brand-text/80 font-sans">
            Recognized across OSTTRA for outstanding execution speed, technical consistency, and platform delivery. Currently onboarding the 2026 new grad cohort.
          </p>
        </div>
      </div>
    </div>

  </div>

  <script is:inline>
    // Live system clock and network latency simulator
    document.addEventListener('DOMContentLoaded', () => {
      // Clock
      const clockEl = document.getElementById('system-clock');
      if (clockEl) {
        setInterval(() => {
          const now = new Date();
          clockEl.innerText = now.toTimeString().split(' ')[0];
        }, 1000);
      }

      // Latency Simulator
      const latencyEl = document.getElementById('system-latency');
      if (latencyEl) {
        setInterval(() => {
          const lat = Math.floor(Math.random() * 8) + 8;
          latencyEl.innerText = `${lat}ms`;
        }, 3000);
      }
    });
  </script>
</Layout>

