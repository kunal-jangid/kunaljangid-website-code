---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BentoItem from '../components/BentoItem.astro';
import ProjectCard from '../components/ProjectCard.tsx';
import SpotifyStatus from '../components/SpotifyStatus.tsx';
import GadgetsCard from '../components/GadgetsCard.tsx';
import FramesCard from '../components/FramesCard.tsx';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

// Zone 1: Personal Projects (Desktop Pets & Notesippy)
const personalProjects = sortedProjects.filter(p => p.data.order <= 2);

// Zone 2: Heavy Systems Ledger (Enterprise & Financial Architecture)
const enterpriseProjects = sortedProjects.filter(p => p.data.order > 2);

// Fetch Spotify telemetry server-side to bypass browser CORS on localhost
let initialSpotifyData = null;
try {
  const res = await fetch('https://spotify-telemetry.kunaljangid2k3.workers.dev');
  if (res.ok) {
    initialSpotifyData = await res.json();
  }
} catch (e) {
  console.warn("Failed to fetch server-side Spotify data:", e);
}
---

<Layout
  title="Kunal Jangid | Associate Software Engineer"
  description="Kunal Jangid - Associate Software Engineer based in Gurugram, IN. Untangling multi-generational financial architectures and building low-allocation systems."
>
  <div class="flex flex-col gap-14 sm:gap-16 md:gap-20 w-full max-w-5xl mx-auto">
    
    <!-- 1. THE HERO DISPATCH & LISTENING TELEMETRY -->
    <section class="flex flex-col gap-6 border-b border-brand-border/40 pb-10">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
        <span class="font-mono text-xs uppercase tracking-widest text-brand-accent font-semibold">
          // DISPATCH 001: ARCHITECTURAL MANIFESTO
        </span>
        <span class="font-display italic text-sm text-brand-muted">
          Edition 2026
        </span>
      </div>

      <!-- Core intro quote / thesis -->
      <p class="font-display italic text-2xl sm:text-3xl md:text-4xl text-brand-text leading-snug tracking-tight max-w-3xl">
        Architecting high-throughput financial platforms and untangling multi-generational legacy systems.
      </p>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pt-2">
        <p class="font-sans text-xs sm:text-sm text-brand-muted leading-relaxed max-w-xl">
          Currently serving as an <span class="text-brand-text font-semibold">Associate Software Engineer at OSTTRA</span> in Gurugram. 
          Specialized in complex state machines, strict regulatory business logic, and low-allocation frontend architectures.
        </p>

        <!-- Live Spotify Listening Tape -->
        <div class="w-full md:max-w-md shrink-0">
          <SpotifyStatus client:load initialData={initialSpotifyData} variant="hero" />
        </div>
      </div>
    </section>

    <!-- 2. ZONE 1: THE FRONTLINE (NEW PERSONAL PROJECTS FIRST) -->
    <section class="flex flex-col gap-6">
      <div class="flex items-center justify-between border-b border-brand-border/60 pb-2">
        <div class="flex items-baseline gap-2.5">
          <span class="font-mono text-xs uppercase tracking-widest text-brand-accent font-semibold">ZONE 01 //</span>
          <h2 class="font-display italic text-lg sm:text-xl text-brand-text font-medium">The Frontline</h2>
          <span class="text-[10px] text-brand-muted font-mono uppercase tracking-wider hidden sm:inline">— Expressive Personal Builds</span>
        </div>
        <span class="text-[10px] font-mono text-brand-muted border border-brand-border px-2 py-0.5 rounded bg-brand-surface">
          {personalProjects.length} RECENT RELEASES
        </span>
      </div>

      <!-- 2-Column Responsive Featured Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6 w-full">
        {personalProjects.map((project, index) => (
          <div class="bg-brand-surface border border-brand-border rounded-lg p-5 sm:p-6 flex flex-col justify-between transition-all hover:border-brand-accent/60">
            <ProjectCard
              client:load
              index={index + 1}
              title={project.data.title}
              subtitle={project.data.subtitle}
              tags={project.data.tags}
              friction={project.data.friction}
              fix={project.data.fix}
              payoff={project.data.payoff}
            />
          </div>
        ))}
      </div>
    </section>

    <!-- 3. ZONE 2: THE HEAVY SYSTEMS LEDGER (ENTERPRISE IMPACT) -->
    <section class="flex flex-col gap-6">
      <div class="flex items-center justify-between border-b border-brand-border/60 pb-2">
        <div class="flex items-baseline gap-2.5">
          <span class="font-mono text-xs uppercase tracking-widest text-brand-accent font-semibold">ZONE 02 //</span>
          <h2 class="font-display italic text-lg sm:text-xl text-brand-text font-medium">The Heavy Systems Ledger</h2>
          <span class="text-[10px] text-brand-muted font-mono uppercase tracking-wider hidden sm:inline">— Enterprise Architecture & Fintech</span>
        </div>
        <span class="text-[10px] font-mono text-brand-muted border border-brand-border px-2 py-0.5 rounded bg-brand-surface">
          {enterpriseProjects.length} CASE STUDIES
        </span>
      </div>

      <!-- Expansive Single-Column Ledger List -->
      <div class="flex flex-col w-full divide-y divide-brand-border/40 border-y border-brand-border/40">
        {enterpriseProjects.map((project, index) => (
          <div class="px-2 sm:px-4 py-2 hover:bg-brand-surface/30 transition-colors">
            <ProjectCard
              client:load
              index={index + 3}
              title={project.data.title}
              subtitle={project.data.subtitle}
              tags={project.data.tags}
              friction={project.data.friction}
              fix={project.data.fix}
              payoff={project.data.payoff}
            />
          </div>
        ))}
      </div>
    </section>

    <!-- 4. ZONE 3: THE TANGIBLE LIFE (DESK SETUP & VISUAL FRAMES) -->
    <section class="flex flex-col gap-6">
      <div class="flex items-center justify-between border-b border-brand-border/60 pb-2">
        <div class="flex items-baseline gap-2.5">
          <span class="font-mono text-xs uppercase tracking-widest text-brand-accent font-semibold">ZONE 03 //</span>
          <h2 class="font-display italic text-lg sm:text-xl text-brand-text font-medium">The Tangible Life</h2>
          <span class="text-[10px] text-brand-muted font-mono uppercase tracking-wider hidden sm:inline">— Analog Frames & Physical Workstations</span>
        </div>
        <span class="text-[10px] font-mono text-brand-muted">ARCHIVE / DIARY</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6 w-full">
        <!-- Visual Frames Gallery Modal Card -->
        <div class="flex flex-col gap-2">
          <span class="text-[10px] font-mono uppercase tracking-widest text-brand-muted font-semibold">01 // PHOTOGRAPHY</span>
          <FramesCard client:load />
        </div>

        <!-- Desk & Hardware Gear Modal Card -->
        <div class="flex flex-col gap-2">
          <span class="text-[10px] font-mono uppercase tracking-widest text-brand-muted font-semibold">02 // WORKSTATION</span>
          <BentoItem span={1} row={1} class="!p-5 border border-brand-border bg-brand-surface cursor-pointer hover:border-brand-accent transition-colors">
            <GadgetsCard client:load />
          </BentoItem>
        </div>

        <!-- OSTTRA Highflyer Recognition Banner -->
        <div class="flex flex-col gap-2">
          <span class="text-[10px] font-mono uppercase tracking-widest text-brand-accent font-semibold">03 // RECOGNITION</span>
          <BentoItem span={1} row={1} class="!p-5 border border-brand-border border-l-4 border-l-brand-accent bg-brand-surface flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 text-brand-accent font-semibold mb-2 font-mono text-xs">
                <span>🏆</span>
                <span class="tracking-wide">HIGHFLYER AWARD</span>
              </div>
              <p class="text-xs leading-relaxed text-brand-muted font-sans">
                Recognized across OSTTRA for outstanding execution speed, technical consistency, and platform delivery. Currently onboarding the 2026 new grad cohort.
              </p>
            </div>
            <span class="text-[9px] font-mono text-brand-muted mt-4 block">★ OSTTRA FINTECH CORP</span>
          </BentoItem>
        </div>
      </div>
    </section>

  </div>
</Layout>

