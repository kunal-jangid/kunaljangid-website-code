---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BentoItem from '../../components/BentoItem.astro';

const blogPosts = await getCollection('blog');
const posts = blogPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout
  title="Writings & Technical Modernizations | Kunal Jangid"
  description="Explore technical write-ups on legacy framework refactoring, high-throughput financial architectures, and quantitative analysis tools by Kunal Jangid."
>
  <div class="max-w-4xl mx-auto px-4 py-8 relative z-10">
    <!-- Back Navigation -->
    <div class="mb-12">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest border border-brand-border px-4 py-2 rounded hover:bg-brand-text hover:text-brand-bg transition-all duration-300"
      >
        ← Go Back
      </a>
    </div>

    <!-- Header Section -->
    <header class="border-b border-brand-border/40 pb-8 mb-12">
      <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-4 text-brand-text">
        Writings & Technical Log
      </h1>
      <p class="text-sm opacity-70 leading-relaxed font-mono">
        Architectural breakdowns, modernizations, and quantitative engineering insights.
      </p>
    </header>

    <!-- Articles List Grid -->
    <div class="grid grid-cols-1 gap-6">
      {posts.map((post) => {
        const formattedDate = post.data.date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });

        return (
          <div class="glass-panel p-6 md:p-8 rounded-2xl flex flex-col justify-between hover:border-brand-accent/50 transition-all duration-300 group">
            <div>
              <div class="flex flex-wrap gap-2 mb-3">
                {post.data.tags.map((tag: string) => (
                  <span class="px-2 py-0.5 text-[9px] font-mono border border-brand-border/20 rounded opacity-75">
                    {tag}
                  </span>
                ))}
              </div>
              <h2 class="text-xl md:text-2xl font-bold tracking-tight mb-3 text-brand-text group-hover:text-brand-accent transition-colors">
                <a href={`/blog/${post.id}`} class="block">
                  {post.data.title}
                </a>
              </h2>
              <p class="text-sm opacity-80 leading-relaxed mb-4 text-brand-text">
                {post.data.description}
              </p>
            </div>
            <div class="flex items-center justify-between border-t border-brand-border/10 pt-4 mt-2">
              <span class="text-xs font-mono opacity-50">
                Published {formattedDate}
              </span>
              <a
                href={`/blog/${post.id}`}
                class="text-xs font-mono uppercase text-brand-accent group-hover:underline"
              >
                Read Article →
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Layout>
