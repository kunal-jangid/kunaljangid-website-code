---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  robots?: string;
}

const { title, description, robots = "index, follow" } = Astro.props;
const pathname = Astro.url.pathname;

const isHome = pathname === "/" || pathname === "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Kunal Jangid, Software Engineer, Gurugram, Fintech, OSTTRA, Web Developer"
    />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <link
      rel="alternate"
      type="text/plain"
      href="/ai.md"
      title="LLM-friendly Developer Profile"
    />
    <link rel="icon" type="image/png" href="/title-selfie.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600;1,9..144,700&family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600;1,9..144,700&family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600;1,9..144,700&family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      />
    </noscript>

    <script is:inline>
      const themeConfig = [
        {
          name: "oatmeal_light",
          label: "Oatmeal Paper",
          bg: "#F7F4E9",
          surface: "#EEE9D8",
          text: "#2B2623",
          muted: "#6E645F",
          accent: "#C85A32",
          accentSub: "#5B7065",
          border: "#D8D0BC",
          isDark: false,
        },
        {
          name: "oatmeal_dark",
          label: "Late-Night Desk",
          bg: "#181615",
          surface: "#221F1E",
          text: "#F4F0EA",
          muted: "#A39B93",
          accent: "#E07A5F",
          accentSub: "#81B29A",
          border: "#332E2C",
          isDark: true,
        },
        {
          name: "vinyl_dark",
          label: "Midnight Vinyl",
          bg: "#111318",
          surface: "#1A1D24",
          text: "#ECEFF4",
          muted: "#9099A8",
          accent: "#B39DDB",
          accentSub: "#4DB6AC",
          border: "#2A2F3B",
          isDark: true,
        },
        {
          name: "vinyl_light",
          label: "Paper & Lavender",
          bg: "#F2F4F7",
          surface: "#E4E8EE",
          text: "#1E222B",
          muted: "#5C6475",
          accent: "#7E57C2",
          accentSub: "#26A69A",
          border: "#D1D7E0",
          isDark: false,
        },
      ];

      let activeThemeIndex = localStorage.getItem("portfolio-theme-state-v3")
        ? parseInt(localStorage.getItem("portfolio-theme-state-v3"))
        : 0;

      if (isNaN(activeThemeIndex) || activeThemeIndex >= themeConfig.length || activeThemeIndex < 0) {
        activeThemeIndex = 0;
      }

      function renderThemePipeline(index, smooth = false) {
        const activeTheme = themeConfig[index];
        const root = document.documentElement;

        if (smooth) {
          root.classList.add("theme-transitioning");
        }

        root.style.setProperty("--bg-color", activeTheme.bg);
        root.style.setProperty("--bg-surface", activeTheme.surface);
        root.style.setProperty("--text-color", activeTheme.text);
        root.style.setProperty("--text-muted", activeTheme.muted);
        root.style.setProperty("--border-color", activeTheme.border);
        root.style.setProperty("--accent-color", activeTheme.accent);
        root.style.setProperty("--accent-sub", activeTheme.accentSub);

        if (activeTheme.isDark) {
          root.classList.add("dark");
        } else {
          root.classList.remove("dark");
        }

        const labelEl = document.getElementById("theme-label");
        if (labelEl) {
          labelEl.innerText = activeTheme.label;
        }

        localStorage.setItem("portfolio-theme-state-v3", index);
        window.activeThemeIndex = index;

        if (smooth) {
          setTimeout(() => {
            root.classList.remove("theme-transitioning");
          }, 400);
        }
      }

      window.themeConfig = themeConfig;
      window.renderThemePipeline = renderThemePipeline;

      // Apply theme immediately
      renderThemePipeline(activeThemeIndex);

      // DOM Theme click bindings
      document.addEventListener("DOMContentLoaded", () => {
        const toggle = document.getElementById("theme-toggle");
        if (toggle) {
          const labelEl = document.getElementById("theme-label");
          if (labelEl) {
            labelEl.innerText = themeConfig[activeThemeIndex].label;
          }
          toggle.addEventListener("click", () => {
            activeThemeIndex = (activeThemeIndex + 1) % themeConfig.length;
            renderThemePipeline(activeThemeIndex, true);
          });
        }

        // Live system clock
        const clockEl = document.getElementById("system-clock");
        if (clockEl) {
          const updateClock = () => {
            const now = new Date();
            clockEl.innerText = now.toTimeString().split(" ")[0];
          };
          updateClock();
          setInterval(updateClock, 1000);
        }

        // Latency Simulator
        const latencyEl = document.getElementById("system-latency");
        if (latencyEl) {
          const updateLatency = () => {
            const lat = Math.floor(Math.random() * 8) + 8;
            latencyEl.innerText = `${lat}ms`;
          };
          updateLatency();
          setInterval(updateLatency, 3000);
        }
      });
    </script>
  </head>
  <body
    class="relative transition-colors duration-300 min-h-screen flex flex-col justify-between pt-16"
  >
    <!-- Seamless Bottom Glass UI Navigation Bar (Disabled/Kept Independently)
    <nav
      class="fixed bottom-4 md:bottom-6 left-1/2 -translate-x-1/2 z-50 glass-panel px-3 py-2 md:px-5 md:py-2.5 rounded-full flex items-center gap-1.5 md:gap-3 backdrop-blur-md shadow-2xl border border-brand-border/40 bg-brand-bg/85"
    >
      <a
        href="/"
        class={`px-3 py-1.5 md:px-4 md:py-2 rounded-full flex items-center gap-2 text-[11px] md:text-xs font-mono uppercase tracking-wider transition-all duration-300 ${
          isHome
            ? "bg-brand-accent/20 text-brand-accent border border-brand-accent/60 shadow-[0_0_14px_var(--accent-color)] font-bold"
            : "hover:bg-brand-text/10 hover:text-brand-accent opacity-70 hover:opacity-100 border border-transparent"
        }`}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="flex-shrink-0"
        >
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>Home</span>
      </a>
    </nav>
    -->

    <!-- HEADER HUB BAR (FULL WIDTH) -->
    <header
      class="relative z-10 max-w-[90vw] xl:max-w-[1400px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 border-b border-brand-border/40 pb-8 flex flex-col md:flex-row md:items-end justify-between gap-6 mt-10 md:mt-14 w-full"
    >
      <div>
        <div class="flex items-center gap-3.5 flex-wrap">
          <h1
            class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight select-none text-brand-text font-display italic"
          >
            Kunal Jangid
          </h1>
          <button
            id="theme-toggle"
            class="text-[10px] border border-brand-border bg-brand-surface text-brand-text px-2.5 py-1 rounded-md font-mono uppercase tracking-wider select-none hover:bg-brand-text hover:text-brand-bg transition-all cursor-pointer active:translate-x-[1px] active:translate-y-[1px]"
            title="Switch theme"
          >
            <span class="opacity-60 mr-1.5">●</span><span id="theme-label">Oatmeal Paper</span>
          </button>
        </div>
        <p
          class="text-xs md:text-sm text-brand-muted uppercase tracking-widest mt-2 font-mono"
        >
          Associate Software Engineer <span class="opacity-40">//</span> Gurugram, IN
        </p>
      </div>
      <div
        class="flex items-center gap-3 sm:gap-4 text-xs text-brand-muted font-mono flex-wrap"
      >
        <span
          >SIGNAL: <span class="text-brand-accent font-semibold"
            >ONLINE</span
          ></span
        >
        <span class="opacity-30 hidden sm:inline">•</span>
        <span class="hidden sm:inline">PING: <span id="system-latency">12ms</span></span>
        <span class="opacity-30">•</span>
        <span>CLOCK: <span id="system-clock">00:00:00</span></span>
        <span class="opacity-30">•</span>
        <a
          href="/resume.pdf"
          download="Kunal_Jangid_Resume.pdf"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 border border-brand-border bg-brand-surface hover:bg-brand-text hover:text-brand-bg text-brand-text rounded-md transition-all active:translate-x-[1px] active:translate-y-[1px]"
          title="Download Kunal's Resume"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Resume</span>
        </a>
      </div>
    </header>

    <main
      class="relative z-10 max-w-[90vw] xl:max-w-[1400px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 py-12 md:py-16 pb-16 md:pb-20 w-full grow"
    >
      <slot />
    </main>

    <!-- Lo-Fi Zine Footer Section -->
    <footer
      class="relative z-10 max-w-[90vw] xl:max-w-[1400px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 pt-10 pb-16 border-t border-brand-border/40 w-full text-xs font-mono flex flex-col sm:flex-row items-center justify-between gap-6 mt-12 md:mt-16 text-brand-muted"
    >
      <div class="flex items-center gap-2">
        <span class="font-display italic text-sm text-brand-text">Kunal Jangid</span>
        <span class="opacity-40">—</span>
        <span>© {new Date().getFullYear()}</span>
      </div>
      <div class="flex flex-wrap gap-3 items-center justify-center">
        <a
          href="/resume.pdf"
          download="Kunal_Jangid_Resume.pdf"
          class="px-3.5 py-1.5 border border-brand-accent/40 bg-brand-surface text-brand-accent hover:bg-brand-accent hover:text-brand-bg rounded-md transition-all active:translate-x-[1px] active:translate-y-[1px] font-semibold flex items-center gap-1.5"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Resume (PDF)</span>
        </a>
        <a
          href="https://www.linkedin.com/in/jangidkunal"
          target="_blank"
          class="px-3.5 py-1.5 border border-brand-border bg-brand-surface hover:bg-brand-text hover:text-brand-bg text-brand-text rounded-md transition-all active:translate-x-[1px] active:translate-y-[1px]"
          >LinkedIn</a
        >
        <a
          href="https://github.com/kunal-jangid/"
          target="_blank"
          class="px-3.5 py-1.5 border border-brand-border bg-brand-surface hover:bg-brand-text hover:text-brand-bg text-brand-text rounded-md transition-all active:translate-x-[1px] active:translate-y-[1px]"
          >GitHub</a
        >
        <a
          href="mailto:thekunaljangid@gmail.com"
          class="px-3.5 py-1.5 border border-brand-border bg-brand-surface hover:bg-brand-text hover:text-brand-bg text-brand-text rounded-md transition-all active:translate-x-[1px] active:translate-y-[1px]"
          >Email</a
        >
      </div>
    </footer>
    <br />
    <!-- Premium Motion Script -->
    <script src="/src/scripts/v2-motion.js"></script>
  </body>
</html>
