---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  robots?: string;
}

const { title, description, robots = "index, follow" } = Astro.props;
const pathname = Astro.url.pathname;

const isHome = pathname === "/" || pathname === "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Kunal Jangid, Software Engineer, Gurugram, Fintech, OSTTRA, Web Developer"
    />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <link
      rel="alternate"
      type="text/plain"
      href="/ai.md"
      title="LLM-friendly Developer Profile"
    />
    <link rel="icon" type="image/png" href="/title-selfie.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Lexend:wght@300;400;500;600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Lexend:wght@300;400;500;600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Lexend:wght@300;400;500;600;700;800&display=swap"
      />
    </noscript>

    <script is:inline>
      const themeConfig = [
        {
          name: "cream",
          bg: "#EEE9DF",
          text: "#2B323F",
          border: "#111111",
          accent: "#356B80",
        },
        {
          name: "nordic_crimson",
          bg: "#1E040B",
          text: "#F5EBEF",
          border: "#690722",
          accent: "#E6223A",
        },
        {
          name: "cyber_copper",
          bg: "#072220",
          text: "#E0ECE9",
          border: "#004D47",
          accent: "#B95118",
        },
        {
          name: "midnight_sage",
          bg: "#261732",
          accent: "#F1EDDF",
          border: "#463556",
          text: "#AEA989",
        },
        {
          name: "royal_sapphire",
          bg: "#112250",
          text: "#F5F4F0",
          border: "#3B507D",
          accent: "#E7E2CE",
        },
        {
          name: "chinu",
          bg: "#FFF0F5",
          text: "#4D1D2C",
          border: "#F5C2D1",
          accent: "#E05688",
        },
      ];

      let activeThemeIndex = localStorage.getItem("portfolio-theme-state")
        ? parseInt(localStorage.getItem("portfolio-theme-state"))
        : 0;

      if (activeThemeIndex >= themeConfig.length) activeThemeIndex = 0;

      function renderThemePipeline(index, smooth = false) {
        const activeTheme = themeConfig[index];
        const root = document.documentElement;

        if (smooth) {
          root.classList.add("theme-transitioning");
        }

        root.style.setProperty("--bg-color", activeTheme.bg);
        root.style.setProperty("--text-color", activeTheme.text);
        root.style.setProperty("--border-color", activeTheme.border);
        root.style.setProperty("--accent-color", activeTheme.accent);

        localStorage.setItem("portfolio-theme-state", index);
        window.activeThemeIndex = index;

        if (smooth) {
          setTimeout(() => {
            root.classList.remove("theme-transitioning");
          }, 400);
        }
      }

      window.themeConfig = themeConfig;
      window.renderThemePipeline = renderThemePipeline;

      // Apply theme immediately
      renderThemePipeline(activeThemeIndex);

      // DOM Theme click bindings
      document.addEventListener("DOMContentLoaded", () => {
        const toggle = document.getElementById("theme-toggle");
        if (toggle) {
          toggle.addEventListener("click", () => {
            activeThemeIndex = (activeThemeIndex + 1) % themeConfig.length;
            renderThemePipeline(activeThemeIndex, true);
          });
        }

        // Live system clock
        const clockEl = document.getElementById("system-clock");
        if (clockEl) {
          const updateClock = () => {
            const now = new Date();
            clockEl.innerText = now.toTimeString().split(" ")[0];
          };
          updateClock();
          setInterval(updateClock, 1000);
        }

        // Latency Simulator
        const latencyEl = document.getElementById("system-latency");
        if (latencyEl) {
          const updateLatency = () => {
            const lat = Math.floor(Math.random() * 8) + 8;
            latencyEl.innerText = `${lat}ms`;
          };
          updateLatency();
          setInterval(updateLatency, 3000);
        }
      });
    </script>
  </head>
  <body
    class="relative transition-colors duration-300 min-h-screen flex flex-col justify-between pt-16"
  >
    <!-- Seamless Bottom Glass UI Navigation Bar (Disabled/Kept Independently)
    <nav
      class="fixed bottom-4 md:bottom-6 left-1/2 -translate-x-1/2 z-50 glass-panel px-3 py-2 md:px-5 md:py-2.5 rounded-full flex items-center gap-1.5 md:gap-3 backdrop-blur-md shadow-2xl border border-brand-border/40 bg-brand-bg/85"
    >
      <a
        href="/"
        class={`px-3 py-1.5 md:px-4 md:py-2 rounded-full flex items-center gap-2 text-[11px] md:text-xs font-mono uppercase tracking-wider transition-all duration-300 ${
          isHome
            ? "bg-brand-accent/20 text-brand-accent border border-brand-accent/60 shadow-[0_0_14px_var(--accent-color)] font-bold"
            : "hover:bg-brand-text/10 hover:text-brand-accent opacity-70 hover:opacity-100 border border-transparent"
        }`}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="flex-shrink-0"
        >
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>Home</span>
      </a>
    </nav>
    -->

    <!-- HEADER HUB BAR (FULL WIDTH) -->
    <header
      class="relative z-10 max-w-[90vw] xl:max-w-[1400px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 border-b border-brand-border/40 pb-10 flex flex-col md:flex-row md:items-center justify-between gap-6 mt-12 md:mt-16 w-full"
    >
      <div>
        <div class="flex items-center gap-3 flex-wrap">
          <h1
            class="text-4xl md:text-5xl font-black tracking-tighter select-none text-brand-accent font-mono"
          >
            KUNAL_JANGID
          </h1>
          <button
            id="theme-toggle"
            class="text-[9px] border border-brand-accent/30 text-brand-accent px-1.5 py-0.5 rounded font-mono uppercase tracking-wider select-none opacity-80 hover:opacity-100 transition-opacity cursor-pointer active:scale-[0.97]"
          >
            • Theme Toggle
          </button>
        </div>
        <p
          class="text-xs md:text-sm opacity-60 uppercase tracking-widest mt-2 font-mono"
        >
          Software Engineer // Gurugram, IN
        </p>
      </div>
      <div
        class="flex items-center gap-4 text-xs md:text-sm text-brand-text/50 font-mono"
      >
        <span
          >STATUS: <span class="theme-accent-highlight animate-pulse font-bold"
            >ONLINE</span
          ></span
        >
        <span>•</span>
        <span>LATENCY: <span id="system-latency">12ms</span></span>
        <span>•</span>
        <span>SYS_TIME: <span id="system-clock">00:00:00</span></span>
      </div>
    </header>

    <main
      class="relative z-10 max-w-[90vw] xl:max-w-[1400px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 py-16 md:py-20 pb-24 md:pb-28 w-full grow"
    >
      <slot />
    </main>

    <!-- Sticky Resume Action -->
    <a
      href="/resume.pdf"
      download="Kunal_Jangid_Resume.pdf"
      class="sticky-resume"
      aria-label="Download Resume"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10" class="download-arrow"></polyline>
        <line x1="12" y1="15" x2="12" y2="3" class="download-shaft"></line>
      </svg>
      <span class="resume-text">Download My Resume</span>
    </a>

    <!-- Premium Footer Section -->
    <footer
      class="relative z-10 max-w-[90vw] xl:max-w-[1400px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 pt-16 pb-24 border-t border-brand-border/20 w-full text-sm font-mono flex flex-col sm:flex-row items-center justify-between gap-6 mt-12 md:mt-20"
    >
      <div class="opacity-55">© {new Date().getFullYear()} KUNAL JANGID.</div>
      <div class="flex flex-wrap gap-4 items-center justify-center">
        <a
          href="https://www.linkedin.com/in/jangidkunal"
          target="_blank"
          class="px-5 py-2.5 border border-brand-border/40 hover:border-brand-accent hover:text-brand-accent rounded-full transition-all duration-300 bg-brand-bg/5 hover:scale-105"
          >LinkedIn</a
        >
        <a
          href="https://github.com/kunal-jangid/"
          target="_blank"
          class="px-5 py-2.5 border border-brand-border/40 hover:border-brand-accent hover:text-brand-accent rounded-full transition-all duration-300 bg-brand-bg/5 hover:scale-105"
          >GitHub</a
        >
        <a
          href="mailto:thekunaljangid@gmail.com"
          class="px-5 py-2.5 border border-brand-border/40 hover:border-brand-accent hover:text-brand-accent rounded-full transition-all duration-300 bg-brand-bg/5 hover:scale-105"
          >Email</a
        >
      </div>
    </footer>
    <br />
    <!-- Premium Motion Script -->
    <script src="/src/scripts/v2-motion.js"></script>
  </body>
</html>
